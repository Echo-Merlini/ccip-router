# Gateway
PORT=3000
# Your gateway hot key — signs every record. NEVER commit a real key. NEVER use a cold wallet here.
GATEWAY_PRIVATE_KEY=0x...
DB_PATH=./data.db

# TSEI Profile A ingestion (POST only). Generate a dedicated random secret;
# do not reuse ADMIN_SECRET. GET observation state remains public.
TSEI_PROFILE_A_INGEST_SECRET=replace-with-at-least-32-random-characters
TSEI_PROFILE_A_RATE_LIMIT_MAX=60
TSEI_PROFILE_A_RATE_LIMIT_WINDOW_SECONDS=60

# Mesh (basic)
PEERS=https://gateway-b.example.com,https://gateway-c.example.com
SYNC_INTERVAL=*/5 * * * *
SYNC_NAMESPACE=agent-attestations

# Advanced (attestation)
REGISTRY_ADDRESS=0x...
CHAIN_ID=8453
RPC_URL=https://mainnet.base.org
